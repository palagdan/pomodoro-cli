{
  "name": "@palagdan/pomodoro-cli",
  "version": "1.0.1",
  "type": "module",
  "bin": {
    "pomodoro": "dist/index.js"
  },
  "exports": {
    "./plugin": {
      "types": "./dist/src/plugin-api.d.ts",
      "default": "./dist/src/plugin-api.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx index.tsx",
    "dev": "tsx watch index.tsx",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:first": "commit-and-tag-version --first-release",
    "test:watch": "vitest"
  },
  "keywords": [
    "pomodoro",
    "timer",
    "cli",
    "terminal",
    "ink",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "description": "Terminal Pomodoro timer built with Ink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palagdan/pomodoro-cli.git"
  },
  "homepage": "https://github.com/palagdan/pomodoro-cli#readme",
  "bugs": {
    "url": "https://github.com/palagdan/pomodoro-cli/issues"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "commit-and-tag-version": "^13.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
